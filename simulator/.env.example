# =============================================================================
# EnRuta — Simulador de Arquitecturas de Software (.env.example)
# Copiar a .env si se desea personalizar puertos en docker compose
# =============================================================================

# Puerto público del frontend web (Nginx reverse proxy + React SPA)
SIM_PORT=8080

# Puerto interno/host opcional de la API FastAPI del simulador
API_PORT=8000

# URL pública oficial desplegada en GitHub Pages (para QR / acceso móvil)
PUBLIC_GITHUB_PAGES_URL=https://teach1030.github.io/EnRuta/
